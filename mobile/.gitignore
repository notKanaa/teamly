# Expo app « Équipe » (React Native). The root .gitignore ignores `.env`: this one is committed on purpose, it only
# holds the public Supabase URL and publishable key (see README.md).
!.env

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders (generated by `expo prebuild`, never committed)
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files (e.g. the local Supabase stack for tests)
.env*.local

# typescript
*.tsbuildinfo

# macOS
.DS_Store
