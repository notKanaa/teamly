<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing is copied by cloud backups or device-to-device transfers. The Auth session must stay on this
    device (like the iOS Keychain item « this device only »), and the notification state (pending reminders, last
    notified assignments) only describes this installation. android:allowBackup="false" covers older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
