<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS only, except for a local Supabase stack during development (iOS: NSAllowsLocalNetworking): the host machine as
    seen from the emulator (10.0.2.2) and the device itself (127.0.0.1 / localhost, e.g. through
    `adb reverse tcp:54321 tcp:54321`). A build configured with an https:// project never talks to these addresses.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
