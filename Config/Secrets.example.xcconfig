// Copy to Config/Secrets.xcconfig (gitignored) or generate it with:
//   SUPABASE_HOST=… SUPABASE_PUBLISHABLE_KEY=… node scripts/write-secrets.mjs
// SUPABASE_HOST is the host only (no "https://": "//" starts a comment in this file).
// Local Supabase stack in the simulator: SUPABASE_SCHEME = http, SUPABASE_HOST = 127.0.0.1:54321 and the key of
// `npx supabase status -o json` (plain HTTP is allowed for local addresses only, NSAllowsLocalNetworking).
APP_BUNDLE_ID = io.github.your-pseudo.equipe
SUPABASE_SCHEME = https
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxx
