// Shared build settings. Values below are defaults; Secrets.xcconfig (gitignored, generated by
// scripts/write-secrets.mjs from CI Variables) overrides them.

// Must be globally unique for sideloading with a free Apple ID (e.g. io.github.<pseudo>.equipe).
APP_BUNDLE_ID = io.github.equipe.app

// Supabase project. Host only — "//" would start a comment in an xcconfig file.
SUPABASE_SCHEME = https
SUPABASE_HOST =
SUPABASE_PUBLISHABLE_KEY =

#include? "Secrets.xcconfig"
